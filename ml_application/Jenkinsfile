// Jenkins Declarative Pipeline for MLOps Deployment
// Pipeline: GitHub -> Jenkins CI -> Docker Containerization -> AWS Cloud Deployment

pipeline {
    agent any

    environment {
        APP_NAME = 'fraud-detection-api'
        IMAGE_TAG = 'v2.4.1'
        DOCKER_REGISTRY = 'docker.io/ml-org'
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_EC2_HOST = '54.210.89.14'
        ACCURACY_THRESHOLD = '95.0'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        ansiColor('xterm')
    }

    stages {
        stage('1. GitHub Source Checkout') {
            steps {
                echo "=========================================================="
                echo "🚀 [TOOL 1: GITHUB] Pulling ML Application source repository"
                echo "=========================================================="
                checkout scm
                sh 'git log -1 --stat'
            }
        }

        stage('2. Automated Testing & Model Validation') {
            steps {
                echo "=========================================================="
                echo "⚙️ [TOOL 2: JENKINS] Executing PyTest & Model Evaluation Gate"
                echo "=========================================================="
                dir('ml_application') {
                    sh 'python -m pytest test_model.py -v'
                    sh 'python train.py'
                }
            }
        }

        stage('3. Docker Container Build') {
            steps {
                echo "=========================================================="
                echo "🐳 [TOOL 3: DOCKER] Packaging ML Model into Container Image"
                echo "=========================================================="
                dir('ml_application') {
                    sh "docker build -t ${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG} -t ${DOCKER_REGISTRY}/${APP_NAME}:latest ."
                    sh "docker images | grep ${APP_NAME}"
                }
            }
        }

        stage('4. Docker Registry Push') {
            steps {
                echo "=========================================================="
                echo "📦 [TOOL 3: DOCKER] Pushing Image to Container Registry"
                echo "=========================================================="
                sh "docker push ${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}"
            }
        }

        stage('5. AWS Cloud Infrastructure Deployment') {
            steps {
                echo "=========================================================="
                echo "☁️ [TOOL 4: AWS] Deploying Container to AWS EC2 Instance"
                echo "=========================================================="
                // Deploys the container to production cloud instance
                sh """
                    docker stop ${APP_NAME} || true
                    docker rm ${APP_NAME} || true
                    docker run -d \\
                        --name ${APP_NAME} \\
                        --restart always \\
                        -p 8000:8000 \\
                        -e MODEL_ENV=production \\
                        ${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('6. Smoke Test & Live Inference') {
            steps {
                echo "=========================================================="
                echo "🎯 [VERIFICATION] Verifying Live AWS Inference Endpoint"
                echo "=========================================================="
                sh """
                    sleep 3
                    curl -s -f http://localhost:8000/health || exit 1
                    curl -s -X POST http://localhost:8000/predict \\
                        -H 'Content-Type: application/json' \\
                        -d '{"amount_usd": 4850.0, "foreign_country": true, "ip_reputation_score": 0.94}'
                """
                echo "\n✅ MLOps Pipeline execution completed successfully across all 4 tools!"
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline succeeded: Real-Time Fraud Detection Engine is live in production!"
        }
        failure {
            echo "❌ Pipeline failed: Deployment aborted. Check model test or container logs."
        }
    }
}
